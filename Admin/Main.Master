    <script type="text/javascript">
        $(function () {

            //Initialize Select2 Elements
            $(".select2").select2();

            //Date picker
            $('.datepicker').datepicker({
                format: 'dd-mm-yyyy',
                autoclose: true
            });

            //Date picker
            $('.datepicker2').datepicker({
                format: 'yyyymmdd',
                autoclose: true
            });


            //Date picker
            $('.datepicker3').datepicker({
                format: 'hh:mm',
                autoclose: true
            });

            $('[data-toggle="tooltip"]').tooltip();

        });
